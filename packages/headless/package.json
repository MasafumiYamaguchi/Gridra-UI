{
  "name": "@gridra-ui/headless",
  "version": "0.2.0",
  "description": "Unstyled React interaction hooks and accessibility bindings for Gridra UI.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MasafumiYamaguchi/Gridra-UI.git"
  },
  "homepage": "https://github.com/MasafumiYamaguchi/Gridra-UI#readme",
  "bugs": {
    "url": "https://github.com/MasafumiYamaguchi/Gridra-UI/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.json --force",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --pool=threads --environment jsdom"
  },
  "peerDependencies": {
    "react": ">=18.2.0"
  },
  "dependencies": {
    "@gridra-ui/core": "0.2.0"
  }
}
