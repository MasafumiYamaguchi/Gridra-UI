    "./dark.css": "./src/dark.css",
    "./light.css": "./src/light.css",
    "./midnight.css": "./src/colors/midnight.css",
    "./forest.css": "./src/colors/forest.css",
    "./ember.css": "./src/colors/ember.css",
    "./themes.css": "./src/themes.css",
    "./colors/*.css": "./src/colors/*.css"
  }
